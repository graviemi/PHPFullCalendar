<?php

return [

	// Application title displayed in the browser tab
	'title' => 'PHPFullCalendar',

	// Set to true to enforce HTTPS — strongly recommended in production
	'secure' => true,

	// Additional HTTP headers sent with every response (CORS, etc.)
