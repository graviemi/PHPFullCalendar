	'styles' => [
		'https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css',
		'https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css',
		'https://fonts.googleapis.com/css2?family=Open+Sans:wght@300;400;500;600;700&display=swap',
	],

	// External JS scripts loaded in <head> before the local PHPFullCalendar.js.
	// Order matters: rrule before FullCalendar, FullCalendar before its rrule connector, SweetAlert before PHPFullCalendar.
	'scripts' => [
		'https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.min.js',
		'https://cdn.jsdelivr.net/npm/ical.js@1.5.0/build/ical.min.js',
		'https://cdn.jsdelivr.net/npm/rrule@2.6.4/dist/es5/rrule.min.js',
		'https://cdn.jsdelivr.net/npm/fullcalendar@6.1.15/index.global.min.js',
		'https://cdn.jsdelivr.net/npm/@fullcalendar/core@6.1.15/locales-all.global.min.js',
		'https://cdn.jsdelivr.net/npm/@fullcalendar/rrule@6.1.15/index.global.min.js',
		'https://cdn.jsdelivr.net/npm/sweetalert@2.1.2/dist/sweetalert.min.js',
	],

	// Authentication sources — one entry per source
	// The key is the source name used internally (e.g. in ACL identifiers: "sourcename.login")
	// Only LDAP is supported for now
	'authentication' => [
		'sourcename' => [
			'method' => 'LDAP',
			'parameters' => [
				'host'     => 'ldap://ldap.example.com:389',
				'startTLS' => true,
				// %s will be replaced by the login entered by the user
				'bindDN'   => 'uid=%s,ou=people,dc=example,dc=com',
			],
		],
	],

	// User information retrieval — one entry per authentication source (same keys)
	'information' => [
		'sourcename' => [
			'method' => 'LDAP',
			'parameters' => [
				'host'       => 'ldap://ldap.example.com:389',
				'startTLS'   => true,
				'base'       => 'ou=people,dc=example,dc=com',
				// %s will be replaced by the login
				'filter'     => '(&(uid=%s)(objectClass=posixAccount))',
				// LDAP attributes to retrieve
				'attributes' => ['cn', 'mail'],
				// Which attribute maps to the display name and email
				'name'       => 'cn',
				'email'      => 'mail',
			],
		],
	],

	// Group resolution — one entry per authentication source (same keys)
	// Leave empty if group-based ACL is not needed
	'groups' => [
		// 'sourcename' => [ ... ],
	],

	// Session configuration
	'session' => [
		// Session lifetime in seconds
		'ttl' => 3600,

		'cookie' => [
			'name'     => 'pfc_session',
			'path'     => '/',
			'domain'   => 'pfc.example.com',
			'secure'   => true,   // should match 'secure' above
			'httpOnly' => true,
		],

		// Session storage backend — only memcached is supported for now
		'handler' => [
			'name'   => 'memcached',
			'host'   => '127.0.0.1',
			'port'   => 11211,
			'prefix' => 'pfc_',   // key prefix to avoid collisions
		],
	],

	// Brute-force protection on authentication. Remove or comment out this whole
	// block to disable it. Blocking is per client IP (see 'trusted_proxies' below
	// when behind a reverse proxy, otherwise everyone shares the proxy IP).
	'security' => [
		// Backend class under PHPFullCalendar\Security\ (only Memcached for now)
		'backend' => 'Memcached',
		'parameters' => [
			'host'       => '127.0.0.1',
			'port'       => 11211,
			'max_try'    => 3,         // failed attempts allowed before blocking
			'quarantine' => 3600,      // block duration in seconds
			'prefix'     => 'pfc_sec_',// memcached key prefix
		],
	],

	// Email sending backend, used by cron.php (crontab : * * * * * php /path/to/cron.php)
	// to deliver alarm emails. Backend class under PHPFullCalendar\Emails\.
	'emails' => [
		'backend' => 'PHPMail',
		'parameters' => [
			'from' => 'calendar@example.com',
		],
	],

	// Reverse proxies whose X-Forwarded-For can be trusted to resolve the real
	// client IP (_::clientIp()). List the IPs of YOUR proxies only. Leave empty
	// when the app is exposed directly — REMOTE_ADDR is then used as-is.
	// Note: matching is on exact IPs (no CIDR ranges).
	'trusted_proxies' => [
		// '127.0.0.1',
	],

	// MySQL / MariaDB connection
	'database' => [
		'driver' => 'mysql',
		'host'   => 'localhost',
		'name'   => 'phpFullCalendar',
		'user'   => 'pfc',
		'pass'   => 'secret',
	],

